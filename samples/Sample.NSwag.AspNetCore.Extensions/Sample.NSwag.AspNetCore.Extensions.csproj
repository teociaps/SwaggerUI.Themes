<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\build\Common.Core.props" />

  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <OpenApiGeneratorDocumentsOnBuild>false</OpenApiGeneratorDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <PackageReference Include="NSwag.AspNetCore" Version="14.6.3" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net9.0' ">
    <PackageReference Include="NSwag.AspNetCore" Version="14.6.3" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <PackageReference Include="NSwag.AspNetCore" Version="14.6.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NSwag.AspNetCore.Extensions\NSwag.AspNetCore.Extensions.csproj" />
  </ItemGroup>

</Project>
