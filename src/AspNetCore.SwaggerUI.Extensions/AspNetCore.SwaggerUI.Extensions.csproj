<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\Common.Core.props" />
  <Import Project="..\..\build\NuGet.props" />

  <!-- Official Version -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <MajorVersion>1</MajorVersion>
    <MinorVersion>0</MinorVersion>
    <PatchVersion>0</PatchVersion>
    <VersionSuffix></VersionSuffix>
    <Version>$(MajorVersion).$(MinorVersion).$(PatchVersion)$(VersionSuffix)</Version>
  </PropertyGroup>

  <!-- Local Development: overrides Versioning.props' shared Debug fallback, which tracks the
       Themes packages' version (currently 3.x) and would otherwise leak into this package. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <MajorVersion>1</MajorVersion>
    <MinorVersion>0</MinorVersion>
    <PatchVersion>0</PatchVersion>
    <VersionSuffix>-$(Revision)</VersionSuffix>
    <Version>$(MajorVersion).$(MinorVersion).$(PatchVersion)$(VersionSuffix)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>AspNetCore.SwaggerUI.Extensions</PackageId>
    <Description>
      Enhance your ASP.NET Core Swagger UI with additional capabilities.
    </Description>
    <PackageTags>
      swagger;swagger-ui;swaggerui;swashbuckle;aspnetcore;webapi;openapi;extension;api-counter;operation-count;tag-extensions
    </PackageTags>
    <IncludeBuildOutput>true</IncludeBuildOutput>
  </PropertyGroup>

  <!-- Upper-bounded ranges: Microsoft.OpenApi had a breaking rewrite between the v1.x line
       (Swashbuckle.AspNetCore 9.x) and the v2.x line (Swashbuckle.AspNetCore 10.x) - Models
       namespace removed, OpenApiDocument.Tags/OpenApiOperation.Tags collection types changed.
       AppendOperationCountToTagDescriptionFilter is multi-targeted for both; the bounds stop
       NuGet from silently floating a TFM onto whichever line it wasn't compiled against. -->
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="[9.0.6,10.0.0)" Condition="'$(TargetFramework)' != 'net10.0'" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="[10.2.3,11.0.0)" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

</Project>
